 ],
 "steps": [
  {
   "isSection": false,
   "order": 0,
   "step": "Bring a large pot of salted water to a boil over high heat. Add the orzo and cook until al dente according to the package instructions. Drain the orzo in a colander.",
   "uuid": "160126AB-7766-4C87-BF4B-A703CEF5342C"
  },
  {
   "isSection": false,
   "order": 1,
   "step": "While the orzo is cooking, heat the olive oil in a large pan over medium-high heat. When the oil begins to shimmer, add the leeks and cook, stirring occasionally, until softened and bright green, about 5 minutes. Add the olives, raisins, pine nuts, garlic, and za'atar and cook, stirring occasionally, until deeply aromatic, about 2 minutes.",
   "uuid": "6842D773-630F-4253-BB16-E97ABE113AB8"
  },
  {
   "isSection": false,
   "order": 2,
   "step": "Transfer the orzo and the leek mixture to a large bowl. Add the parsley, lemon juice, and 2 teaspoons salt and stir to combine. Serve the orzo hot or let it cool to room temperature and store it in an airtight container to serve later, chilled or at room temp.",
   "uuid": "F14EF275-839D-4B92-950B-CD971A02F63D"
  }
 ],
 "defaultScale": 1,
 "serves": 4,
