 "rating": 4,
 "steps": [
  {
   "order": 0,
   "uuid": "6357B67D-409C-44B4-AA61-FBB181BDA341",
   "isSection": false,
   "step": "Place the beef, soy sauce, lemon juice, olive oil and cumin in a bowl and stir to coat the beef evenly with the marinade. Cover the bowl with plastic wrap and refrigerate for at least 3 hours or as long as overnight."
  },
  {
   "order": 1,
   "uuid": "6BC5A568-753F-4D60-A1EB-80BEF517C7B9",
   "isSection": false,
   "step": "Preheat the broiler or set up the grill and preheat it to high."
  },
  {
   "order": 2,
   "uuid": "5DBD6CF7-7FA6-4094-926A-79525F3A54AB",
   "isSection": false,
   "step": "Remove the beef from the marinade and thread it onto 8 skewers, alternating pieces of bell pepper, onion, mushrooms and tomatoes between the pieces of meat."
  },
  {
   "order": 3,
   "uuid": "FFDAD66D-B948-47E2-AFA1-5832D4A20399",
   "isSection": false,
   "step": "Broil or grill the kebabs until the beef is tender, turning occasionally, 8 to 10 minutes."
  }
 ]
}