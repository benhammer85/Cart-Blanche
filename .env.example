# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used to create the household on first login and for Alexa.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the app (used in login emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://cart-blanche.vercel.app

# Who may log in: comma-separated, optional "=Display Name"
ALLOWED_EMAILS=ben@example.com=Ben,molly@example.com=Molly

# --- AI (optional; Google AI Studio free tier). Without a key the rule-based planner is used. ---
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite
AI_API_KEY=

# --- Alexa (optional) ---
# Skill ID from the Alexa developer console (amzn1.ask.skill....)
ALEXA_SKILL_ID=
